{
  "name": "@haszno/mcp",
  "version": "0.4.0",
  "description": "MCP server for the Haszno API (stdio transport) — also importable as a library via @haszno/mcp/lib",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "haszno-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./lib": {
      "import": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.hu.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/haszno-labs/haszno-mcp"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
